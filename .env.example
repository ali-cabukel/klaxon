# Database (default: SQLite under ./data/klaxon.db)
# DATABASE_URL=sqlite+aiosqlite:///./data/klaxon.db

# Slack app (from api.slack.com Basic Information)
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_SIGNING_SECRET=
SLACK_BOT_SCOPES=app_mentions:read,channels:history,chat:write,commands,im:history,im:write,reactions:write,users:read
PUBLIC_BASE_URL=https://YOUR-NGROK-HOST

# Secrets — generate locally:
#   openssl rand -hex 32
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
STATE_SECRET=
TOKEN_ENCRYPTION_KEY=

# Agent (optional — without these the bot echoes)
ANTHROPIC_API_KEY=
AGENT_MODEL=claude-sonnet-4-20250514
CONVERSATION_TTL_SECONDS=1800

# Set to stdio to force MCP MultiServerMCPClient instead of in-process tools
# MCP_URL=
# KLAXON_USE_MCP=0
